// Stage D Showcase: Bend-style 4-tier Constitutional Laws & Termination `decreases`

type Combatant {
  id: u32,
  hp: u32,
  shield: u32,
}

fn take_hit(c: Combatant ~>.{hp}, dmg: u32) {
  c.hp = c.hp -| dmg
}

fn mask_low(x: Int(0..=15), m: Int(0..=15)) -> Int(0..=15) {
  x & m
}

// Tier 0: Structural frame discharge
law preserve_combatant_id(c: View(Combatant, Exclusive)) {
  preserves c.id, c.shield
}

// Tier 1: Exhaustive finite domain proof (bitwise invariant, 256 states)
law mask_bounded(x: Int(0..=15), m: Int(0..=15)) {
  always mask_low(x, m) <= m
}

// Tier 2 symbolic auto-prover + Tier 3 Lean 4.35.0 kernel proof
law bounded_damage(hp: u32, dmg: u32) {
  never hp < hp -| dmg
}

law damage_recovery(hp: u32, dmg: u32) {
  when dmg <= hp
  always (hp -| dmg) + dmg == hp
}

law add_comm_u32(x: u32, y: u32) {
  always x + y == y + x
}

law min_le_add_u32(a: u32, b: u32, c: u32) {
  always min(a, b) <= a + c
}

fn sum_countdown(mut n: u32) -> u32 {
  let mut acc: u32 = 0u32
  while n > 0u32 decreases n {
    acc = acc +% n
    n = n - 1u32
  }
  acc
}

fn count_up_sum() -> u32 {
  let mut i: u32 = 0u32
  let mut acc: u32 = 0u32
  while i < 10u32 decreases 10u32 - i {
    acc = acc +% i
    i = i + 1u32
  }
  acc
}

fn factorial_down(n: u32) -> u32 decreases n {
  if n == 0u32 {
    1u32
  } else {
    n *% factorial_down(n - 1u32)
  }
}

fn main() {
  let mut hero = Combatant { id: 1u32, hp: 100u32, shield: 25u32 }
  take_hit(hero, 40u32)
  let tri = sum_countdown(5u32)
  let up = count_up_sum()
  let fact5 = factorial_down(5u32)
  let recovered = (hero.hp) + 40u32
  println("hero.hp=", hero.hp, " recovered=", recovered, " masked=", mask_low(13, 6))
  println("sum_countdown(5)=", tri, " count_up(10)=", up, " fact(5)=", fact5)
}
