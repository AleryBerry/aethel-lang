// Multi-module math library (Stage E)
pub const SCALE: i32 = 10

fn internal_secret(x: i32) -> i32 {
  x +% 1
}

pub fn clamp(x: i32, lo: i32, hi: i32) -> i32 {
  if x < lo { lo } else if x > hi { hi } else { x }
}

pub fn cap_score(score: u32, limit: u32) -> u32 {
  min(score, limit)
}

pub fn abs_diff(a: u32, b: u32) -> u32 {
  if a >= b { a -% b } else { b -% a }
}
