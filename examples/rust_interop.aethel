// Synchronous Rust C-ABI Staticlib Interop & RustOwn Affine Lifecycle (Stage E)
opaque type RustBuf

extern "rust" {
  fn fast_dot(xs: [f32], ys: [f32]) -> f32
  fn scale_in_place(xs: [mut f32], factor: f32)
  fn rust_buf_new() -> RustBuf
  fn rust_buf_push(b: View(RustBuf, Exclusive), val: i32)
  fn rust_buf_sum(b: View(RustBuf, Shared)) -> i32
  fn rust_buf_drop(b: RustBuf)
}

fn check_threshold(res: Result(i32, u8)) -> i32 {
  case res {
    Ok(v) -> v
    Err(code) -> 0 -% (code as i32)
  }
}

fn main() {
  let a: [f32] = [1.0f32, 2.0f32, 3.0f32, 4.0f32]
  let mut b: [mut f32] = [2.0f32, 3.0f32, 4.0f32, 5.0f32]

  let dot_before = fast_dot(a, b)

  // Disjoint half-open mutable slices [0..2] and [2..4] mutated safely in Rust.
  scale_in_place(b[0..2], 2.0f32)
  scale_in_place(b[2..4], 3.0f32)
  let dot_after = fast_dot(a, b)

  // Opaque RustOwn affine handle lifecycle: push -> shared sum -> single drop.
  let buf = rust_buf_new()
  rust_buf_push(buf, 15)
  rust_buf_push(buf, 27)
  let total = rust_buf_sum(buf)
  rust_buf_drop(buf)

  let ok_total = check_threshold(Ok(total))
  println("dot_before=", dot_before, " dot_after=", dot_after, " rust_buf_sum=", ok_total)
}
