@layout(aosoa(8))
type Player {
  pos: i32,
  delta: i7,
  active: u1,
  health: Int(0..=100),
}

type Status {
  Idle,
  Moving(u8),
}

fn step(p: Player ~>.{pos, delta}) {
  p.pos = p.pos +% (p.delta as i32)
}

fn widen_sum(x: i7, y: i7) -> i8 {
  x + y
}

fn take_damage(hp: Int(0..=100), dmg: u8) -> Int(0..=100) {
  hp -| dmg
}

fn guarded_add(a: u8, b: u8) -> u8 {
  if a <= 100 && b <= 155 {
    a + b
  } else {
    255
  }
}

fn describe(s: Status) -> u8 {
  case s {
    Idle -> 0
    Moving(speed) -> speed
  }
}

law movement_safe(p: View(Player, Exclusive)) {
  preserves p.health, p.active
  always p.health <= 100
  never p.health > 100
}

fn main() {
  let a: i7 = -40
  let b: i7 = 63
  let narrowed_sum = a + b
  let wide = widen_sum(a, b)
  let c: u3 = 5
  let d: u4 = 9
  let auto_prod = c * d

  let mut player = Player { pos: 100, delta: -15, active: 1, health: 80 }
  step(player)
  let next_hp = take_damage(player.health, 120)
  let status = Moving(guarded_add(12, 30))

  println("Hello from Aethel + Zig's built-in compiler!")
  println("i7+i7 narrowed = ", narrowed_sum, ", widened (i8) = ", wide, ", u3*u4 = ", auto_prod)
  println("player pos = ", player.pos, ", saturating health = ", next_hp)
  println("moving speed = ", describe(status))

  for i in 0..=2 {
    println("  step #", i)
  }
}
