import std/vec as vec
import std/map as map
import std/set as set
import std/deque as deque
import std/option as opt
import std/result as res
import std/cmp as cmp
import std/math as math
import std/str as str

@layout(aosoa(8))
type Particle {
  x: f32,
  y: f32,
  vx: f32,
  vy: f32,
}

@layout(soa)
type Entity {
  id: u32,
  px: i32,
  health: u32,
}

fn boost_entities(es: Collection(Entity) ~>.{ px, health }) -> u32 {
  let mut total: u32 = 0
  for e in es {
    total = total +| e.health
  }
  total +| 2
}

fn build_scores() -> Vec(u32) {
  let mut xs: Vec(u32) = vec.new()
  vec.push(xs, 10)
  vec.push(xs, 25)
  vec.push(xs, 40)
  xs
}

pub fn main() {
  // 1. Dynamic @layout(aosoa(8)) Vec growth across 64B-aligned tile boundaries (0 -> 8 -> 16)
  //    plus fused SIMD map_in_place |> fold pass.
  let mut particles: Vec(Particle) = vec.new()
  let mut i: u32 = 0
  let mut fx: f32 = 0.0
  while i < 12 {
    vec.push(particles, Particle { x: fx, y: 1.0, vx: 2.0, vy: 0.5 })
    fx = fx + 1.0
    i = i + 1
  }
  let sum_x = particles
    |> map_in_place(fn(p) { p.x = p.x + p.vx; p.y = p.y + p.vy })
    |> fold(0.0, fn(acc, p) { acc + p.x })

  // 2. Dynamic @layout(soa) Vec passed zero-copy to path-borrowed Collection(Entity) ~>.{ px, health }
  let mut entities: Vec(Entity) = vec.with_capacity(4)
  vec.push(entities, Entity { id: 1, px: 10, health: 80 })
  vec.push(entities, Entity { id: 2, px: 20, health: 90 })
  let health_sig = boost_entities(vec.as_collection(entities))
  vec.push(entities, Entity { id: 3, px: 30, health: health_sig })

  // 3. Ownership move return + in-place mutation + pure std modules (math, cmp, option, result, str)
  let mut scores = build_scores()
  let popped = opt.unwrap_or(vec.pop(scores), 0)
  let swapped = opt.unwrap_or(vec.swap_remove(scores, 0), 0)
  let remaining = opt.unwrap_or(vec.get(scores, 0), 0)

  let g = math.gcd_u32(48, 18)
  let p = math.pow_u32(2, 6)
  let r: Result(u32, u32) = Ok(g +| p)
  let r_val = res.unwrap_or(r, 0)
  let tag = str.concat("stage-g:", "ok")
  let tag_ok = str.starts_with(tag, "stage-g") && cmp.is_lt(cmp.compare_u32(g, p))

  // 4. Flat linear-probing Map, Set, and circular RingDeque (zero allocator parameters)
  let mut roster: Map(String, u32) = map.new()
  map.put(roster, "alpha", 100)
  map.put(roster, "beta", 200)
  let old_alpha = opt.unwrap_or(map.insert(roster, "alpha", 150), 0)
  let cur_alpha = opt.unwrap_or(map.get(roster, "alpha"), 0)
  let rem_beta = opt.unwrap_or(map.remove(roster, "beta"), 0)

  let mut ids: Set(u32) = set.new()
  let ins1 = set.insert(ids, 7)
  let ins_dup = set.insert(ids, 7)
  let rem_id = set.remove(ids, 7)

  let mut dq: Deque(i32) = deque.new()
  deque.push_back(dq, 20)
  deque.push_front(dq, 10)
  deque.push_back(dq, 30)
  let front_v = opt.unwrap_or(deque.pop_front(dq), 0)
  let back_v = opt.unwrap_or(deque.pop_back(dq), 0)
  let mid_v = opt.unwrap_or(deque.get(dq, 0), 0)

  // 5. 500-iteration allocation/deallocation stress loop (checked by Zig 0.17 init.gpa for 0 leaks)
  let mut iter: u32 = 0
  let mut loop_acc: u64 = 0
  while iter < 500 {
    let mut lv: Vec(u32) = vec.new()
    vec.push(lv, iter)
    vec.push(lv, iter + 1)
    let mut lm: Map(u32, u32) = map.new()
    map.put(lm, iter, iter * 2)
    let mut ls: Set(u32) = set.new()
    let _ = set.insert(ls, iter)
    let mut ld: Deque(i32) = deque.new()
    deque.push_back(ld, iter as i32)
    loop_acc = loop_acc +| lv.len +| lm.len +| ls.len +| ld.len
    iter = iter + 1
  }

  println("AoSoA(8) Particle len=", particles.len, " cap=", vec.capacity(particles), " sum_x=", sum_x)
  println("SoA Entity len=", entities.len, " boost=", health_sig, " tail_px=", entities[2].px)
  println("Scores popped=", popped, " swapped=", swapped, " rem=", remaining, " math=", r_val, " tag_ok=", tag_ok)
  println("Map old=", old_alpha, " cur=", cur_alpha, " rem=", rem_beta, " Set=", ins1, ins_dup, rem_id)
  println("Deque f=", front_v, " m=", mid_v, " b=", back_v, " gpa_loop_ops=", loop_acc)
}
