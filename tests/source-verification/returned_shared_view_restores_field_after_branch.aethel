type Pair { left: u8, right: u8, }
fn fetch(pair: Pair ~>.{left}) -> View(u8, Shared) {
  pair.left
}
fn main() -> u8 {
  let mut pair = Pair { left: 42, right: 11, };
  if pair.left == 42 {
    let held = fetch(pair);
    pair.right = held;
  } else {
    pair.right = 0;
  };
  pair.left = 9;
  pair.right
}
