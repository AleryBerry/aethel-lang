type Pair { left: u8, right: u8, }
fn clear(pair: Pair ~>.{left}) {
  while pair.left > 0 decreases pair.left {
    pair.left = pair.left -| 1;
  };
}
fn main() -> u8 {
  let mut pair = Pair { left: 12, right: 11, };
  view exclusive held = pair.right {
    clear(pair);
    let _ = held;
  };
  pair.left
}
