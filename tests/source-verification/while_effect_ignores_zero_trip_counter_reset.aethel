type Meter { remaining: u8, pulses: u8, }
fn main() -> u8 {
  let mut meter = Meter { remaining: 96, pulses: 21, };
  while meter.remaining > 0 decreases meter.remaining {
    meter.remaining = meter.remaining -| 24;
    for _ in 0..0 { meter.remaining = 250; };
    meter.pulses = meter.pulses -| 1;
  };
  meter.pulses
}
