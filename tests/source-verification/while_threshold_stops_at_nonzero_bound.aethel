type Meter { count: u8, tally: u8, }
fn main() -> u8 {
  let mut meter = Meter { count: 19, tally: 30, };
  while meter.count > 7 decreases meter.count {
    meter.count = meter.count -| 4;
    meter.tally = meter.tally -| 3;
  };
  if meter.count != 7 { meter.tally = 0; } else { };
  meter.tally
}
